// Prisma 7: Der Client wird in einen Projektordner generiert (output ist
// Pflicht) und die DB-URL kommt aus prisma.config.ts, nicht mehr aus dem
// datasource-Block. Unter src/, damit der @/-Alias greift (@/generated/prisma/client).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  termine       Termin[]
  erinnerungen  Erinnerung[]
}

model Termin {
  id             String       @id @default(cuid())
  titel          String
  datum          DateTime
  uhrzeit        String
  beschreibung   String?
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  erinnerungen   Erinnerung[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Erinnerung {
  id          String   @id @default(cuid())
  terminId    String
  termin      Termin   @relation(fields: [terminId], references: [id], onDelete: Cascade)
  erinnerung  String
  datum       DateTime
  uhrzeit     String
  beschreibung String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
